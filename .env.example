# 复制为 .env 后修改。VERSION 需与导入的镜像 tag 一致（docker load 后 docker images 查看）
VERSION=2.0.0
SECRET_KEY=请改成随机长字符串
LDAP_ENABLED=false
# 首次启动种子管理员（仅用户表为空时生效；建议先设为强密码再启动）
BILLHUB_ADMIN_USER=admin
BILLHUB_ADMIN_PASS=admin
# 批量导入用户的初始密码（须满足强度规则：8 位以上含大小写与特殊字符；首登强制修改）
# BILLHUB_IMPORT_PASSWORD=Abc12345!
# LDAP/AD 可选配置（LDAP_ENABLED=true 时填写）
# LDAP_URI=ldap://ad.example.com:389
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_USER_DN_TEMPLATE=uid={user},ou=users,dc=example,dc=com
